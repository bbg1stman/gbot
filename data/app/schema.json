{
  "$comment": "런타임 기록 스키마. 실제 개인정보(이름·연락처·식별번호)는 두지 않는다.",
  "User": {
    "type": "object",
    "required": [
      "id",
      "created",
      "subjects"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "내부 사용자 id. 실명 아님"
      },
      "created": {
        "type": "string",
        "format": "date-time"
      },
      "subjects": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "band",
            "estimate",
            "last_diagnostic"
          ],
          "properties": {
            "band": {
              "enum": [
                "미달",
                "경계",
                "안정",
                "여유"
              ]
            },
            "estimate": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "last_diagnostic": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "description": "키는 subject_code (kor, math, eng, soc, sci, his)"
      }
    }
  },
  "Attempt": {
    "type": "object",
    "required": [
      "id",
      "user_id",
      "item_id",
      "session_id",
      "correct",
      "choice",
      "time_ms",
      "axis",
      "type_id",
      "band_at_time",
      "ts"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "item_id": {
        "type": "string"
      },
      "session_id": {
        "type": "string"
      },
      "correct": {
        "type": "boolean"
      },
      "choice": {
        "type": [
          "integer",
          "null"
        ],
        "description": "고른 선지 인덱스. 미응답은 null"
      },
      "time_ms": {
        "type": "integer",
        "minimum": 0
      },
      "axis": {
        "type": "string",
        "description": "풀 당시 단원/기능"
      },
      "type_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "band_at_time": {
        "enum": [
          "미달",
          "경계",
          "안정",
          "여유"
        ]
      },
      "ts": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "Session": {
    "type": "object",
    "required": [
      "id",
      "user_id",
      "kind",
      "subject",
      "item_ids",
      "score"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "kind": {
        "enum": [
          "diagnostic",
          "drill",
          "examset"
        ]
      },
      "subject": {
        "type": "string"
      },
      "item_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "score": {
        "type": "number"
      }
    }
  },
  "Plan": {
    "type": "object",
    "required": [
      "id",
      "user_id",
      "week",
      "items"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "week": {
        "type": "string",
        "description": "ISO 주, 예: 2026-W33"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "subject",
            "band",
            "action",
            "count"
          ],
          "properties": {
            "subject": {
              "type": "string"
            },
            "band": {
              "enum": [
                "미달",
                "경계",
                "안정",
                "여유"
              ]
            },
            "action": {
              "type": "string"
            },
            "count": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "WrongNote": {
    "type": "object",
    "description": "오답노트. 문항 단위 복습 카드. official 엠바고 문항은 auto_hint가 빈 문자열.",
    "required": [
      "id",
      "user_id",
      "item_id",
      "attempt_id",
      "subject_code",
      "type_id",
      "axis",
      "wrong_choice",
      "correct_choice",
      "learner_note",
      "auto_hint",
      "pattern_id",
      "review_count",
      "next_review",
      "resolved",
      "created",
      "updated"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "item_id": {
        "type": "string"
      },
      "attempt_id": {
        "type": "string"
      },
      "subject_code": {
        "type": "string"
      },
      "type_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "axis": {
        "type": "string"
      },
      "wrong_choice": {
        "type": [
          "integer",
          "null"
        ]
      },
      "correct_choice": {
        "type": [
          "integer",
          "null"
        ]
      },
      "learner_note": {
        "type": "string",
        "description": "수험생이 적은 메모. 비어 있어도 됨"
      },
      "auto_hint": {
        "type": "string",
        "description": "item.explanation 또는 함정에서 뽑은 짧은 힌트. 공식 엠바고면 빈 문자열"
      },
      "pattern_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "review_count": {
        "type": "integer",
        "minimum": 0
      },
      "next_review": {
        "type": [
          "string",
          "null"
        ],
        "description": "ISO date 또는 null"
      },
      "resolved": {
        "type": "boolean"
      },
      "created": {
        "type": "string",
        "format": "date-time"
      },
      "updated": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "ErrorPattern": {
    "type": "object",
    "description": "수험생별 오답 패턴 통계. 목록(catalog)은 pack/error_patterns.json.",
    "required": [
      "id",
      "user_id",
      "pattern_id",
      "subject_code",
      "type_id",
      "miss_count",
      "last_missed",
      "note"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "pattern_id": {
        "type": "string"
      },
      "subject_code": {
        "type": [
          "string",
          "null"
        ]
      },
      "type_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "miss_count": {
        "type": "integer",
        "minimum": 0
      },
      "last_missed": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "note": {
        "type": "string"
      }
    }
  },
  "TypeStat": {
    "type": "object",
    "description": "반복 오답 유형. misses>=3 또는 streak_wrong>=2 이면 반복해서 틀리는 유형.",
    "required": [
      "id",
      "user_id",
      "type_id",
      "subject_code",
      "attempts",
      "misses",
      "streak_wrong",
      "last_missed"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "type_id": {
        "type": "string"
      },
      "subject_code": {
        "type": "string"
      },
      "attempts": {
        "type": "integer",
        "minimum": 0
      },
      "misses": {
        "type": "integer",
        "minimum": 0
      },
      "streak_wrong": {
        "type": "integer",
        "minimum": 0
      },
      "last_missed": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      }
    }
  },
  "ItemStat": {
    "type": "object",
    "description": "문항 단위 숙달. 봤는지, 몇 번 틀렸는지, 복습 기한.",
    "required": [
      "id",
      "user_id",
      "item_id",
      "subject_code",
      "type_id",
      "axis",
      "attempts",
      "misses",
      "last_correct",
      "last_choice",
      "last_ts",
      "streak_wrong",
      "ease",
      "next_review",
      "history"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "item_id": {
        "type": "string"
      },
      "subject_code": {
        "type": [
          "string",
          "null"
        ]
      },
      "type_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "axis": {
        "type": [
          "string",
          "null"
        ]
      },
      "attempts": {
        "type": "integer",
        "minimum": 0
      },
      "misses": {
        "type": "integer",
        "minimum": 0
      },
      "last_correct": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "last_choice": {
        "type": [
          "integer",
          "null"
        ]
      },
      "last_ts": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "streak_wrong": {
        "type": "integer",
        "minimum": 0
      },
      "ease": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1,
        "description": "0-1. 정답 비율. 시도 없으면 null"
      },
      "next_review": {
        "type": [
          "string",
          "null"
        ],
        "description": "ISO date 또는 null"
      },
      "history": {
        "type": "array",
        "maxItems": 10,
        "description": "최근 시도. 최대 10",
        "items": {
          "type": "object",
          "required": [
            "attempt_id",
            "correct",
            "ts"
          ],
          "properties": {
            "attempt_id": {
              "type": "string"
            },
            "correct": {
              "type": "boolean"
            },
            "ts": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  },
  "Evaluation": {
    "type": "object",
    "description": "종합 평가. 계산 결과이며 스냅샷으로도 저장한다. pass_rules: 과목 40, 평균 60.",
    "required": [
      "user_id",
      "generated_at",
      "overall",
      "subjects",
      "weak_axes",
      "weak_types",
      "weak_patterns",
      "weak_items",
      "focus"
    ],
    "properties": {
      "user_id": {
        "type": "string"
      },
      "generated_at": {
        "type": "string",
        "format": "date-time"
      },
      "overall": {
        "type": "object",
        "required": [
          "estimate_avg",
          "pass_ready",
          "subject_min_risk",
          "average_risk"
        ],
        "properties": {
          "estimate_avg": {
            "type": "number"
          },
          "pass_ready": {
            "type": "boolean",
            "description": "모든 과목>=40 이고 평균>=60"
          },
          "subject_min_risk": {
            "type": "boolean",
            "description": "어느 과목 estimate < 40"
          },
          "average_risk": {
            "type": "boolean",
            "description": "평균 estimate < 60"
          }
        }
      },
      "subjects": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "band",
            "estimate",
            "attempts",
            "accuracy",
            "weak"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "band": {
              "enum": [
                "미달",
                "경계",
                "안정",
                "여유"
              ]
            },
            "estimate": {
              "type": "number"
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "accuracy": {
              "type": [
                "number",
                "null"
              ]
            },
            "weak": {
              "type": "boolean",
              "description": "estimate < 40 또는 band=미달"
            }
          }
        }
      },
      "weak_axes": {
        "type": "array",
        "description": "accuracy < 0.6 또는 misses>=2",
        "items": {
          "type": "object",
          "required": [
            "subject_code",
            "axis",
            "attempts",
            "misses",
            "accuracy"
          ],
          "properties": {
            "subject_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "axis": {
              "type": "string"
            },
            "attempts": {
              "type": "integer"
            },
            "misses": {
              "type": "integer"
            },
            "accuracy": {
              "type": "number"
            }
          }
        }
      },
      "weak_types": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type_id",
            "subject_code",
            "misses",
            "streak_wrong"
          ],
          "properties": {
            "type_id": {
              "type": "string"
            },
            "subject_code": {
              "type": "string"
            },
            "misses": {
              "type": "integer"
            },
            "streak_wrong": {
              "type": "integer"
            }
          }
        }
      },
      "weak_patterns": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "pattern_id",
            "miss_count"
          ],
          "properties": {
            "pattern_id": {
              "type": "string"
            },
            "miss_count": {
              "type": "integer"
            }
          }
        }
      },
      "weak_items": {
        "type": "array",
        "description": "ItemStat misses>=1 이고 마지막이 미해결(last_correct가 true가 아님)",
        "items": {
          "type": "object",
          "required": [
            "item_id",
            "misses",
            "last_correct"
          ],
          "properties": {
            "item_id": {
              "type": "string"
            },
            "misses": {
              "type": "integer"
            },
            "last_correct": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "focus": {
        "type": "array",
        "description": "과락 위험 과목 먼저, 그다음 약한 유형",
        "items": {
          "type": "object",
          "required": [
            "subject_code",
            "reason",
            "action"
          ],
          "properties": {
            "subject_code": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
