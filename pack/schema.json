{
  "$comment": "런타임 기록 스키마. 실제 개인정보(이름·연락처·식별번호)는 두지 않는다. 앱은 pack/ 만 읽는다. 편집은 data/ + wiki/.",
  "User": {
    "type": "object",
    "required": [
      "id",
      "created",
      "subjects"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "내부 사용자 id. 실명 아님"
      },
      "created": {
        "type": "string",
        "format": "date-time"
      },
      "subjects": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "band",
            "estimate",
            "last_diagnostic"
          ],
          "properties": {
            "band": {
              "enum": [
                "미달",
                "경계",
                "안정",
                "여유"
              ]
            },
            "estimate": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "last_diagnostic": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "description": "키는 subject_code (kor, math, eng, soc, sci, his)"
      }
    }
  },
  "Attempt": {
    "type": "object",
    "required": [
      "id",
      "user_id",
      "item_id",
      "session_id",
      "correct",
      "choice",
      "time_ms",
      "axis",
      "type_id",
      "band_at_time",
      "ts"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "item_id": {
        "type": "string"
      },
      "session_id": {
        "type": "string"
      },
      "correct": {
        "type": "boolean"
      },
      "choice": {
        "type": [
          "integer",
          "null"
        ],
        "description": "고른 선지 인덱스. 미응답은 null"
      },
      "time_ms": {
        "type": "integer",
        "minimum": 0
      },
      "axis": {
        "type": "string",
        "description": "풀 당시 단원/기능"
      },
      "type_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "band_at_time": {
        "enum": [
          "미달",
          "경계",
          "안정",
          "여유"
        ]
      },
      "ts": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "Session": {
    "type": "object",
    "required": [
      "id",
      "user_id",
      "kind",
      "subject",
      "item_ids",
      "score"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "kind": {
        "enum": [
          "diagnostic",
          "drill",
          "examset"
        ]
      },
      "subject": {
        "type": "string"
      },
      "item_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "score": {
        "type": "number"
      }
    }
  },
  "Plan": {
    "type": "object",
    "required": [
      "id",
      "user_id",
      "week",
      "items"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "week": {
        "type": "string",
        "description": "ISO 주, 예: 2026-W33"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "subject",
            "band",
            "action",
            "count"
          ],
          "properties": {
            "subject": {
              "type": "string"
            },
            "band": {
              "enum": [
                "미달",
                "경계",
                "안정",
                "여유"
              ]
            },
            "action": {
              "type": "string"
            },
            "count": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "WrongNote": {
    "type": "object",
    "description": "오답노트. 문항 단위 복습 카드. official 엠바고 문항은 auto_hint가 빈 문자열.",
    "required": [
      "id",
      "user_id",
      "item_id",
      "attempt_id",
      "subject_code",
      "type_id",
      "axis",
      "wrong_choice",
      "correct_choice",
      "learner_note",
      "auto_hint",
      "pattern_id",
      "review_count",
      "next_review",
      "resolved",
      "created",
      "updated"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "item_id": {
        "type": "string"
      },
      "attempt_id": {
        "type": "string"
      },
      "subject_code": {
        "type": "string"
      },
      "type_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "axis": {
        "type": "string"
      },
      "wrong_choice": {
        "type": [
          "integer",
          "null"
        ]
      },
      "correct_choice": {
        "type": [
          "integer",
          "null"
        ]
      },
      "learner_note": {
        "type": "string",
        "description": "수험생이 적은 메모. 비어 있어도 됨"
      },
      "auto_hint": {
        "type": "string",
        "description": "item.explanation 또는 함정에서 뽑은 짧은 힌트. 공식 엠바고면 빈 문자열"
      },
      "pattern_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "review_count": {
        "type": "integer",
        "minimum": 0
      },
      "next_review": {
        "type": [
          "string",
          "null"
        ],
        "description": "ISO date 또는 null"
      },
      "resolved": {
        "type": "boolean"
      },
      "created": {
        "type": "string",
        "format": "date-time"
      },
      "updated": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "ErrorPattern": {
    "type": "object",
    "description": "수험생별 오답 패턴 통계. 목록(catalog)은 pack/error_patterns.json.",
    "required": [
      "id",
      "user_id",
      "pattern_id",
      "subject_code",
      "type_id",
      "miss_count",
      "last_missed",
      "note"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "pattern_id": {
        "type": "string"
      },
      "subject_code": {
        "type": [
          "string",
          "null"
        ]
      },
      "type_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "miss_count": {
        "type": "integer",
        "minimum": 0
      },
      "last_missed": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "note": {
        "type": "string"
      }
    }
  },
  "TypeStat": {
    "type": "object",
    "description": "반복 오답 유형. misses>=3 또는 streak_wrong>=2 이면 반복해서 틀리는 유형.",
    "required": [
      "id",
      "user_id",
      "type_id",
      "subject_code",
      "attempts",
      "misses",
      "streak_wrong",
      "last_missed"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "type_id": {
        "type": "string"
      },
      "subject_code": {
        "type": "string"
      },
      "attempts": {
        "type": "integer",
        "minimum": 0
      },
      "misses": {
        "type": "integer",
        "minimum": 0
      },
      "streak_wrong": {
        "type": "integer",
        "minimum": 0
      },
      "last_missed": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      }
    }
  },
  "Item": {
    "type": "object",
    "description": "pack/items.json 한 행. 공식 슬롯은 stem/choices/answer가 null.",
    "required": [
      "id",
      "type",
      "source",
      "status",
      "subject_code"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "type": {
        "const": "item"
      },
      "source": {
        "enum": [
          "official",
          "original"
        ]
      },
      "status": {
        "enum": [
          "embargoed",
          "ready"
        ]
      },
      "kind": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      },
      "subject_code": {
        "type": "string"
      },
      "type_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "types.json id. unit/skill에서 매핑"
      },
      "trap_tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "media": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "stem": {
        "type": [
          "string",
          "null"
        ]
      },
      "choices": {
        "type": [
          "array",
          "null"
        ]
      },
      "answer": {
        "type": [
          "integer",
          "null"
        ]
      },
      "explanation": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "Concept": {
    "type": "object",
    "description": "wiki/concepts/*.md 를 컴파일한 개념 카드",
    "required": [
      "id",
      "subject",
      "axis",
      "title",
      "body"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      },
      "subject_code": {
        "type": "string"
      },
      "axis": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "body": {
        "type": "string"
      }
    }
  },
  "Type": {
    "type": "object",
    "description": "진단 축에서 만든 채점 유형. 공식 문항이 아님",
    "required": [
      "id",
      "subject_code",
      "axis",
      "label",
      "description"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "subject_code": {
        "type": "string"
      },
      "axis": {
        "type": "string"
      },
      "label": {
        "type": "string"
      },
      "description": {
        "type": "string"
      }
    }
  },
  "Level": {
    "type": "object",
    "description": "pack/levels.json. 밴드와 합격 규칙"
  },
  "Blueprint": {
    "type": "object",
    "description": "과목 진단 설계. axes는 교육과정 단원/기능",
    "required": [
      "subject",
      "subject_code",
      "item_count",
      "axis",
      "axes"
    ]
  },
  "PlanTemplate": {
    "type": "object",
    "description": "밴드별 주간 계획 템플릿",
    "required": [
      "band",
      "label",
      "focus",
      "daily_items"
    ]
  },
  "ErrorPatternCatalog": {
    "type": "object",
    "description": "pack/error_patterns.json 공통 오답 패턴 목록",
    "required": [
      "id",
      "label",
      "description"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "subject_code": {
        "type": [
          "string",
          "null"
        ]
      },
      "type_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "label": {
        "type": "string"
      },
      "description": {
        "type": "string"
      }
    }
  }
}
