            "chapter_id",
            "subject_code",
            "title",
            "attempts",
            "misses",
            "accuracy",
            "parent_id"
          ],
          "properties": {
            "chapter_id": {
              "type": "string"
            },
            "subject_code": {
              "type": [
                "string",
