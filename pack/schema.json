    "type": "object",
    "required": [
      "id",
      "created",
      "subjects"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "내부 사용자 id. 실명 아님"
      },
      "created": {
        "type": "string",
        "format": "date-time"
      },
      "subjects": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "band",
            "estimate",
            "last_diagnostic"
          ],
          "properties": {
            "band": {
              "enum": [
                "미달",
                "경계",
                "안정",
                "여유"
              ]
            },
            "estimate": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "last_diagnostic": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "description": "키는 subject_code (kor, math, eng, soc, sci, his)"
      }
    }
  },
