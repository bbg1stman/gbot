                "경계",
                "안정",
                "여유"
              ]
            },
            "estimate": {
              "type": "number"
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "accuracy": {
              "type": [
                "number",
                "null"
              ]
            },
            "weak": {
              "type": "boolean",
              "description": "estimate < 40 또는 band=미달"
            }
          }
        }
      },
      "weak_axes": {
        "type": "array",
        "description": "accuracy < 0.6 또는 misses>=2",
        "items": {
          "type": "object",
          "required": [
            "subject_code",
            "axis",
            "attempts",
            "misses",
            "accuracy"
          ],
          "properties": {
            "subject_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "axis": {
              "type": "string"
            },
            "attempts": {
              "type": "integer"
            },
            "misses": {
              "type": "integer"
            },
            "accuracy": {
              "type": "number"
            }
          }
        }
      },
      "weak_types": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type_id",
            "subject_code",
            "misses",
            "streak_wrong"
          ],
          "properties": {
            "type_id": {
              "type": "string"
            },
            "subject_code": {
              "type": "string"
            },
            "misses": {
              "type": "integer"
            },
            "streak_wrong": {
              "type": "integer"
            }
          }
        }
      },
      "weak_patterns": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "pattern_id",
            "miss_count"
          ],
          "properties": {
            "pattern_id": {
              "type": "string"
            },
            "miss_count": {
              "type": "integer"
            }
          }
        }
      },
      "weak_items": {
        "type": "array",
        "description": "ItemStat misses>=1 이고 마지막이 미해결(last_correct가 true가 아님)",
        "items": {
          "type": "object",
          "required": [
            "item_id",
            "misses",
            "last_correct"
          ],
          "properties": {
            "item_id": {
              "type": "string"
            },
            "misses": {
              "type": "integer"
            },
            "last_correct": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "focus": {
        "type": "array",
        "description": "과락 위험 과목 먼저, 그다음 약한 유형",
