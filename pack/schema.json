  "Evaluation": {
    "type": "object",
    "description": "종합 평가. 계산 결과이며 스냅샷으로도 저장한다. pass_rules: 과목 40, 평균 60. 취약 구간은 target_year 의 edition 챕터로 본다.",
    "required": [
      "user_id",
      "generated_at",
      "target_year",
      "edition_id",
      "overall",
      "subjects",
      "weak_axes",
      "weak_chapters",
      "weak_types",
      "weak_patterns",
      "weak_items",
      "focus"
    ],
    "properties": {
      "user_id": {
        "type": "string"
      },
      "generated_at": {
        "type": "string",
        "format": "date-time"
      },
      "target_year": {
        "type": "integer",
        "description": "응시 연도. 이 해의 edition 단원 트리를 쓴다"
      },
      "edition_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "target_year 에 해당하는 editions.json id"
      },
      "overall": {
        "type": "object",
        "required": [
          "estimate_avg",
          "pass_ready",
          "subject_min_risk",
          "average_risk"
        ],
        "properties": {
          "estimate_avg": {
            "type": "number"
          },
          "pass_ready": {
            "type": "boolean",
            "description": "모든 과목>=40 이고 평균>=60"
          },
          "subject_min_risk": {
            "type": "boolean",
            "description": "어느 과목 estimate < 40"
          },
          "average_risk": {
            "type": "boolean",
            "description": "평균 estimate < 60"
          }
        }
      },
      "subjects": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "band",
            "estimate",
            "attempts",
            "accuracy",
            "weak"
          ],
          "properties": {
            "code": {
              "type": "string"
